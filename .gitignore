# Firebase service-account credentials — never commit
firebase-service-account.json

# Runtime logs, generated PDF cache, DB dumps — keep the folder, not the contents
logs/*
!logs/.gitkeep
!logs/.htaccess

# Employee face enrollment images — user data, never commit
uploads/faces/

# DB backup dumps — contain employee TIN/SSS/PhilHealth/bank/salary PII, kept
# locally as a rollback safety net only, never tracked in git.
backups/*.sql
