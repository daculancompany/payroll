RewriteEngine On

# ── Force HTTPS ──────────────────────────────────────────────────────────
# includes/session_bootstrap.php marks the session cookie Secure whenever the
# request arrives over HTTPS. With no redirect, the same browser could reach
# the app on both schemes: the cookie set on https:// is then withheld on any
# http:// request, PHP sees no session, and the user is bounced to the login
# page — intermittently, and differently on every machine, because HSTS and
# Chrome's HTTPS-First upgrade are per-browser state. Pinning the site to one
# scheme is what makes the session cookie behave the same everywhere.
#
# Three independent HTTPS signals are checked before redirecting. Behind a
# TLS-terminating proxy (LiteSpeed on shared hosting) only some of them are
# set, and redirecting on a false negative would be an infinite loop, so the
# rule fires only when all three say plain HTTP.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{SERVER_PORT} !=443
# Local XAMPP has no certificate; leave development on plain HTTP.
# HTTP_HOST carries the port when it is not 80, so localhost:8080 must still
# match here — without the optional port group it would fall through and get
# redirected to a certificate that does not exist.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|.*\.local|.*\.test)(:[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} !^(192\.168\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.) [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Access ───────────────────────────────────────────────────────────────
# Explicitly allow every visitor IP/network. This app does its own auth in
# PHP; no LAN or IP range should ever be denied at the web-server level.
# (Overrides any inherited directory-level restriction on the host.)
Require all granted

# ── Compression ──────────────────────────────────────────────────────────
# Pages like dtr-details render one table row per attendance record, so a
# 13-day / 361-employee batch is ~70 MB of HTML — over half of it indentation.
# gzip takes that to ~1.8 MB on the wire (~40x). Costs a little CPU, saves
# seconds of transfer on every page.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    # Already-compressed formats gain nothing and just burn CPU
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|ico|zip|gz|pdf|woff2?)$ no-gzip dont-vary
</IfModule>

# ── Static asset caching ─────────────────────────────────────────────────
# Only fingerprint-free vendor assets and images; PHP output is never cached
# here because DTR/payroll pages change on every approval.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 7 days"
    ExpiresByType application/javascript  "access plus 7 days"
    ExpiresByType text/javascript         "access plus 7 days"
    ExpiresByType image/png               "access plus 30 days"
    ExpiresByType image/jpeg              "access plus 30 days"
    ExpiresByType image/svg+xml           "access plus 30 days"
    ExpiresByType image/webp              "access plus 30 days"
    ExpiresByType font/woff2              "access plus 30 days"
</IfModule>

# Firebase service-account credentials must never be downloadable
<Files "firebase-service-account.json">
    Require all denied
</Files>

# ── Never serve data, source or backup files ─────────────────────────────
# Real files bypass the router by design (the -f rule below), so anything
# sitting in this folder is downloadable by default. payroll.sql (full schema
# + data), vendor.zip (1.9 MB of source) and the stray *.txt query dumps were
# all publicly fetchable. Deny by extension rather than naming files one at a
# time, so a future dump doesn't quietly become public too.
<FilesMatch "\.(sql|zip|tar|gz|tgz|bak|old|log|ini|md|lock|yml|yaml|sh)$">
    Require all denied
</FilesMatch>

# The scratch query dumps in this folder are .txt, but robots.txt must stay
# fetchable, so .txt is handled separately from the list above.
<FilesMatch "\.txt$">
    Require all denied
</FilesMatch>
<Files "robots.txt">
    Require all granted
</Files>

# composer.json/lock and the Firebase service account are the only .json files
# here and none should ever be served. (The PWA manifests are .webmanifest and
# are unaffected.)
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>

# Version-control metadata. <Directory>/<DirectoryMatch> are not permitted in
# .htaccess (Apache 500s on them), so match on the request path instead.
RedirectMatch 404 /\.git
RedirectMatch 404 /\.DS_Store

# Script execution is disabled inside the writable upload directories by the
# dedicated .htaccess files in uploads/ and assets/img/ — per-directory rules
# cannot be expressed from here.

# ── Baseline security response headers ───────────────────────────────────
<IfModule mod_headers.c>
    # Stop the browser MIME-sniffing a user upload into something executable.
    Header always set X-Content-Type-Options "nosniff"
    # This is an internal payroll tool; it has no business being framed.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Keep payroll data out of search indexes even if a box is internet-facing.
    Header always set X-Robots-Tag "noindex, nofollow"
    # Make the browser go straight to HTTPS from then on, so a fresh machine
    # never touches http:// even once — the redirect above only fixes the
    # request that already went out. env=HTTPS keeps this off the plain-HTTP
    # LAN/XAMPP installs, where advertising HSTS would lock the site out.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Serve the PWA manifest with the correct MIME type (some Apache builds don't
# map .webmanifest by default) so browsers treat the app as installable.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Pass Authorization header through to PHP (Apache strips it by default)
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# No hardcoded RewriteBase — Apache infers it from the directory this
# .htaccess lives in, so it works both in a subfolder (e.g. /payroll/ on
# local XAMPP) and at the web root (live server with no payroll folder).

# ── Let real files (ajax.php, *-server.php, assets/, uploads/, etc.) pass ──
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Clean URL → index.php router ─────────────────────────────────────────
# /payroll/employee          → index.php?page=employee
# /payroll/dtr-details?id=5  → index.php?page=dtr-details&id=5
RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?page=$1 [L,QSA]
